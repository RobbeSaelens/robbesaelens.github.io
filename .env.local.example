# Local development settings. Copy to `.env.local` (git-ignored via `*.local`).
# Note: Vite also reads `.env.local` during a local `npm run build`.

# Base URL of the status worker used by the private /status page, without a
# trailing slash. This is a public URL, not a secret. `npx wrangler dev` in the
# status-worker repo serves it on port 8787; its ALLOWED_ORIGINS must include
# the Vite dev origin (http://localhost:5173) for the browser to accept replies.
VITE_STATUS_API_URL=http://localhost:8787
